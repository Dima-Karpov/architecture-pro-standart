        <mxCell id="101" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#C0392B;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="1392" y="378" width="28" height="22" as="geometry" />
        </mxCell>
        <mxCell id="102" value="&lt;b&gt;Красный контур&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#34495E&quot;&gt;мешает открыть депозит в интернет-банке&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#C0392B&quot;&gt;1 ставка · 2 решение · 3 открытие&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1C2833;" vertex="1" parent="1">
          <mxGeometry x="1428" y="374" width="288" height="52" as="geometry" />
        </mxCell>
        <mxCell id="95" value="&lt;b&gt;Кредитный контур&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1C2833;" vertex="1" parent="1">
          <mxGeometry x="1392" y="434" width="324" height="22" as="geometry" />
        </mxCell>
        <mxCell id="96" value="Утолщённая рамка на карте. В контур входят АБС (заявка, риск спецставки, зачисление), кредитный конвейер, скоринг и БКИ. Протоколы обмена — на схеме интеграции." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1C2833;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1392" y="458" width="324" height="72" as="geometry" />
        </mxCell>
        <mxCell id="97" value="&lt;b&gt;Стек as-is&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1C2833;" vertex="1" parent="1">
          <mxGeometry x="1392" y="536" width="324" height="22" as="geometry" />
        </mxCell>
        <mxCell id="98" value="&lt;b&gt;АБС&lt;/b&gt; — Delphi, Oracle, PL/SQL&lt;br&gt;&lt;b&gt;Интернет-банк&lt;/b&gt; — ASP.NET MVC, прямое подключение к БД АБС&lt;br&gt;&lt;b&gt;Сайт&lt;/b&gt; — PHP, React, без связи с возможностями&lt;br&gt;&lt;b&gt;Кол-центр&lt;/b&gt; — React, Spring Boot, PostgreSQL&lt;br&gt;&lt;b&gt;Кредитный конвейер&lt;/b&gt; — Camunda, Oracle&lt;br&gt;&lt;b&gt;Скоринг&lt;/b&gt; — Python, Flask, PostgreSQL&lt;br&gt;&lt;b&gt;БКИ&lt;/b&gt; — внешний REST&lt;br&gt;&lt;b&gt;СМС-шлюз телеком-оператора&lt;/b&gt; — стек в кейсе не назван" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1C2833;align=left;verticalAlign=top;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1392" y="562" width="324" height="168" as="geometry" />
        </mxCell>
        <mxCell id="99" value="&lt;b&gt;Не входит в as-is&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1C2833;" vertex="1" parent="1">
          <mxGeometry x="1392" y="738" width="324" height="22" as="geometry" />
        </mxCell>
        <mxCell id="100" value="Онлайн-депозит, заявка на кредит с сайта и предодобренные кредиты — цели следующих заданий. Топ-менеджмент на карте не показан: операционных систем у него нет." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1C2833;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1392" y="762" width="324" height="78" as="geometry" />
        </mxCell>
        <mxCell id="gap-b18" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="976" y="264" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gap-b25" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="976" y="362" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gap-b27" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1332" y="362" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gap-docs" value="только загрузка документов" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#C0392B;" vertex="1" parent="1">
          <mxGeometry x="1190" y="440" width="162" height="32" as="geometry" />
        </mxCell>
        <mxCell id="gap-b46a" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
