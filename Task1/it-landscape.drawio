<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.11" type="device">
  <diagram id="it-landscape" name="IT-ландшафт as-is">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1288" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Банк «Стандарт». IT-ландшафт as-is" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1C2833;" vertex="1" parent="1">
          <mxGeometry x="24" y="14" width="1336" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Матрица: подразделение (или канал) × возможность 2 уровня. В ячейке — система, которой пользуются сейчас. Пустая ячейка — возможность системой не закрывается." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#34495E;" vertex="1" parent="1">
          <mxGeometry x="24" y="46" width="1336" height="20" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Выноска. Сайт банка&lt;/b&gt; — PHP, React. Маркетинговая витрина: клиент только читает материалы.&lt;br&gt;Ни одну возможность 2 уровня не закрывает. Заявки с сайта и онлайн-операции в as-is отсутствуют." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF8E1;strokeColor=#9A7D0A;size=14;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=10;spacingRight=8;fontColor=#1C2833;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="74" width="660" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ib-callout" value="&lt;b&gt;Выноска. Интернет-банк&lt;/b&gt; — ASP.NET MVC, прямое подключение к БД АБС.&lt;br&gt;В as-is только платежи и текущие счета. Ни одну возможность 2 уровня не закрывает: депозит и накопительный счёт здесь не открываются." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF8E1;strokeColor=#9A7D0A;size=14;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=10;spacingRight=8;fontColor=#1C2833;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="74" width="660" height="68" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Подразделение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;↓ кто пользуется&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1C2833;strokeColor=#1C2833;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="150" width="268" height="108" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Продажи и маркетинг" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A5276;strokeColor=#1A5276;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
