        <mxCell id="gap-b46b" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="976" y="686" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gap-b53" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C0392B;strokeColor=#C0392B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="976" y="858" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gap-callout" value="&lt;b&gt;Digital-оповещения&lt;/b&gt;&lt;br&gt;СМС есть, открытия нет. АБС инициирует СМС после ставки бэк-офиса.&lt;br&gt;&lt;br&gt;Пока ставка, решение и открытие счёта у бэк-офиса, почты и Excel, интернет-банк депозит и накопительный счёт не открывает." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FDEDEC;strokeColor=#C0392B;strokeWidth=1.5;size=14;fontSize=12;fontFamily=Helvetica;align=left;spacingLeft=10;spacingRight=8;spacingTop=4;fontColor=#1C2833;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1378" y="1082" width="352" height="168" as="geometry" />
        </mxCell>
      </root>
