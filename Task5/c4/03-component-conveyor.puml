@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include tags.inc

LAYOUT_TOP_DOWN()

title Компоненты C4 — кредитный конвейер\nСтарт создаёт процесс. Статус уходит после скоринга, у предодобренной — после сотрудника.\nЧтение условий — витрина, не старт. Стрелка от вызывающего.

Person(officer, "Сотрудник кредитования", "Ведёт предодобренную заявку в свой рабочий день", $tags="existing")

System(site, "Сайт", "Витрина читает условия. Процесс этим вызовом не стартует", $tags="existing")
System(apps, "Сервис заявок", "Стартует процесс после accepted и повторяет заявку без отметки. В Oracle конвейера не пишет", $tags="existing")
System(score, "Скоринг", "Python. Для нового клиента с сайта берёт общие данные бюро и в АБС не идёт", $tags="existing")
System(abs, "АБС", "Oracle. Заявка из обмена. Новую менеджер создаёт, только если обмен её не принёс", $tags="existing")

Container_Boundary(conv, "Кредитный конвейер") {
  Component(terms, "Чтение условий", "Java", "Витрина сайта. Условия продукта. Не старт процесса и не Oracle АБС", $tags="new")
  Component(online, "Онлайн-старт процесса", "Camunda", "Создаёт процесс с applicationId. Статус отсюда не уходит. Повтор второй процесс не создаёт", $tags="new")
  Component(scoreCall, "Вызов скоринга", "Camunda", "Уже есть. Паспорт на сайте — сразу. Иначе тот же API. Паспорта нет — мгновенного вызова нет", $tags="existing")
  Component(human, "Шаг сотрудника", "Camunda", "Только предодобренная заявка. Вечер и выходной ждут следующего рабочего дня", $tags="existing")
  Component(statusOut, "Отдача статуса", "Camunda", "После скоринга. У предодобренной — после сотрудника. Повтор по applicationId, пока сервис не запишет пару", $tags="new")
  Component(daily, "Суточный обмен с АБС", "обмен баз", "Уже есть. Не чаще раза в сутки. Стык — applicationId, в том числе без одобрения", $tags="existing")
  ComponentDb(oracle, "База конвейера", "Oracle", "Своя база процесса и условий. Сервис заявок сюда не пишет", $tags="existing")
}

Rel(site, terms, "Условия продукта", "HTTPS JSON через API Gateway\nне старт процесса", $tags="new")
Rel(terms, oracle, "Читает условия", "SQL\nвнутри конвейера, не АБС", $tags="new")
Rel(apps, online, "Старт после accepted", "HTTPS, старт процесса Camunda\napplicationId\nповтор заявки без отметки", $tags="new")
Rel(online, oracle, "Процесс заявки", "SQL\nвнутри конвейера", $tags="new")
Rel(online, scoreCall, "Если нужен расчёт", "вызов внутри процесса", $tags="new")
Rel(scoreCall, score, "Расчёт заявки", "HTTPS, API скоринга", $tags="existing")
Rel(online, statusOut, "Без мгновенного расчёта", "вызов внутри процесса\nпаспорта нет", $tags="new")
Rel(scoreCall, human, "Предодобренная заявка", "вызов внутри процесса\nпосле расчёта", $tags="new")
Rel(officer, human, "Завершает шаг", "работа в Camunda", $tags="existing")
Rel(human, statusOut, "После сотрудника", "вызов внутри процесса", $tags="new")
Rel(scoreCall, statusOut, "Без сотрудника", "вызов внутри процесса\nсайт или нет предодобрения", $tags="new")
Rel(statusOut, apps, "Статус решения", "HTTPS JSON\napplicationId и статус\nповтор той же пары", $tags="new")
Rel(abs, daily, "Заявка в АБС", "обмен баз, раз в сутки\nтот же applicationId", $tags="existing")
Rel(daily, abs, "Статус заявки", "раз в сутки", $tags="existing")
Rel(daily, oracle, "Стыкует ту же заявку", "SQL\nвнутри конвейера", $tags="existing")

note as convNote
  Частоту обмена не меняем.
  Новую заявку в АБС создают, только если обмен этот applicationId не принёс.
end note

SHOW_LEGEND()
@enduml
